# ---------------------------------------------------------------------------
# Site configuration. Everything the portfolio reads at build time lives here,
# so hosting only means editing this file (or setting the same keys in your
# host's dashboard: Vercel / Netlify / Cloudflare Pages all support VITE_*).
#
# Vite only exposes variables prefixed with VITE_. Restart `npm run dev` after
# changing anything here — env values are inlined at build time, not read live.
# Put anything secret or machine-specific in .env.local instead (git-ignored).
# ---------------------------------------------------------------------------

# --- Identity ---------------------------------------------------------------
VITE_SITE_TITLE=Your Name — Your Role
VITE_NAME=Your Name
VITE_ROLE=Your Role
VITE_STACK=Your stack
VITE_LOCATION_NOTE=Open to Relocation

# --- Links ------------------------------------------------------------------
# Leave a URL empty to hide its icon in the navbar.
VITE_GITHUB_URL=https://github.com/your-handle
VITE_LINKEDIN_URL=https://www.linkedin.com/in/your-handle/
VITE_EMAIL=you@example.com

# Served from public/. If you set VITE_BASE_PATH below, prefix this to match.
VITE_RESUME_URL=/resume.pdf
VITE_RESUME_FILENAME=resume.pdf

# --- Availability -----------------------------------------------------------
# false hides the pulsing beacon in the dock and the status line in the footer.
VITE_OPEN_TO_WORK=true
VITE_OPEN_TO_WORK_LABEL=Open to work
VITE_FOOTER_STATUS=Currently exploring roles

# --- Sections ---------------------------------------------------------------
# false drops Blog from the dock and the route.
VITE_SHOW_BLOG=true

# --- Deploy -----------------------------------------------------------------
# Root deploys (custom domain, Vercel, Netlify) keep "/". For a GitHub Pages
# project site use "/<repo-name>/" — and prefix VITE_RESUME_URL to match.
VITE_BASE_PATH=/
